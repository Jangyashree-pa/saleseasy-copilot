# Copy to .env for local development. Never commit .env.
# On a hosting platform, set these as environment variables instead.

# anthropic | openai_compatible | mock
# If unset: "anthropic" when ANTHROPIC_API_KEY is set, otherwise "mock" (rules baseline, no LLM).
LLM_PROVIDER=anthropic

# --- Anthropic (default) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Optional: low | medium | high (empty = model default)
LLM_EFFORT=

# --- Any OpenAI-compatible endpoint (only if LLM_PROVIDER=openai_compatible) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
# json_schema (strict, preferred) | json_object | none
OPENAI_JSON_MODE=json_schema

# --- LLM call limits ---
LLM_TIMEOUT_SECONDS=25
LLM_MAX_TOKENS=4096

# --- Abuse and cost limits ---
MAX_INPUT_CHARS=2000
MAX_BODY_BYTES=16384
RATE_LIMIT_PER_MINUTE=10
DAILY_REQUEST_CAP=500
# Number of trusted proxies in front of the app (Render/Railway: 1). 0 = ignore X-Forwarded-For.
TRUSTED_PROXY_HOPS=0

# Lets the demo page simulate LLM failures (no LLM call is made when simulating).
ALLOW_FAILURE_SIMULATION=true

LOG_LEVEL=INFO
